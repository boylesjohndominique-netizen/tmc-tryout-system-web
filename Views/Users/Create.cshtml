@model UserFormViewModel
@{ ViewData["Title"] = "New account"; }

<div class="page-head">
    <div>
        <div class="crumbs"><a asp-action="Index">User accounts</a> / New account</div>
        <h1>New account</h1>
    </div>
</div>

<form asp-action="Create" method="post" class="card-x" data-once>
    <partial name="_UserForm" model="Model" />
    <div class="form-section">
        <h3><i class="bi bi-key"></i>Password</h3>
        <p>Share the temporary password with the user. They can change it after signing in.</p>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters with a letter and a number.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Create account</button>
        <a asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
