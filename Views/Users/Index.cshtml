@model UserListViewModel
@{ ViewData["Title"] = "User accounts"; }

<div class="page-head">
    <div>
        <h1>User accounts</h1>
        <p>Create accounts for coaches and evaluators, and control who can sign in.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-gold"><i class="bi bi-person-plus me-1"></i>New account</a>
    </div>
</div>

<div class="card-x">
    <form method="get" class="filter-bar">
        <div class="field grow">
            <label for="search">Search</label>
            <div class="search-box"><i class="bi bi-search"></i><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Name, username or email" /></div>
        </div>
        <div class="field">
            <label for="role">Role</label>
            <select id="role" name="role" class="form-select">
                <option value="">All roles</option>
                @foreach (var r in Roles.All)
                {
                    <option value="@r" selected="@(Model.Role == r)">@r</option>
                }
            </select>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-light-x">Reset</a>
        </div>
    </form>

    @if (Model.Users.Count == 0)
    {
        <div class="empty-state"><div class="icon-tile"><i class="bi bi-person-x"></i></div><h3>No accounts match</h3><p>Try a different search or clear the filters.</p></div>
    }
    else
    {
        <div class="table-responsive-x">
            <table class="table table-x">
                <thead><tr><th>User</th><th>Role</th><th>Assigned sports</th><th>Last sign-in</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    var initials = string.Concat(u.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
                    <tr>
                        <td>
                            <div class="person">
                                <span class="avatar avatar-sm">@initials</span>
                                <span><strong>@u.FullName</strong><small>@u.Username@(string.IsNullOrEmpty(u.Email) ? "" : " · " + u.Email)</small></span>
                            </div>
                        </td>
                        <td><span class="badge-soft badge-soft-info"><i class="bi bi-@UiHelpers.RoleIcon(u.Role)"></i>@u.Role</span></td>
                        <td>
                            @if (u.Role == Roles.Coach || u.Role == Roles.Evaluator)
                            {
                                var names = u.SportAssignments.Where(x => x.Sport != null).Select(x => x.Sport!.Name).OrderBy(n => n).ToList();
                                <text>@(names.Count == 0 ? "None yet" : string.Join(", ", names))</text>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("MMM d, yyyy h:mm tt") : "Never")</td>
                        <td>
                            @if (u.IsActive) { <span class="badge-soft badge-soft-success">Active</span> }
                            else { <span class="badge-soft badge-soft-muted">Deactivated</span> }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn-action" title="Edit account"><i class="bi bi-pencil"></i></a>
                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn-action" title="Reset password"><i class="bi bi-key"></i></a>
                                <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" data-confirm="@(u.IsActive ? "Deactivate this account? The user will be signed out." : "Reactivate this account?")">
                                    <button type="submit" class="btn-action" title="@(u.IsActive ? "Deactivate" : "Activate")"><i class="bi @(u.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i></button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" data-confirm="Delete this account permanently?">
                                    <button type="submit" class="btn-action danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="result-note">Showing @Model.Users.Count @(Model.Users.Count == 1 ? "account" : "accounts").</div>
    }
</div>
