@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }

<div class="page-head">
    <div>
        <div class="crumbs"><a asp-action="Index">User accounts</a> / Reset password</div>
        <h1>Reset password</h1>
        <p>Set a new password for <strong>@Model.FullName</strong> (@Model.Username).</p>
    </div>
</div>

<div class="row"><div class="col-xl-6 col-lg-8">
<form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="card-x" data-once>
    <input type="hidden" asp-for="Id" />
    <div class="form-section">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-x"></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <div class="form-text">At least 8 characters with a letter and a number.</div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-key me-1"></i>Reset password</button>
        <a asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
</div></div>
