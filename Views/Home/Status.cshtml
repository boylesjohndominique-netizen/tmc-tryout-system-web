@{
    int code = ViewBag.Code is int c ? c : 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Error " + code;
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    var text = code == 404 ? "We could not find that page" : (code == 403 ? "You cannot open that page" : "That request did not work");
}
<div class="error-wrap">
    <div class="error-code">@code</div>
    <h1 class="h4 fw-bold mt-3">@text</h1>
    <p class="text-muted">Check the address or go back to the dashboard.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Back to dashboard</a>
</div>
