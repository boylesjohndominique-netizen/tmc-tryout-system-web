@model CompareViewModel
@{ ViewData["Title"] = "Compare applicants"; }

<div class="page-head">
    <div>
        <div class="crumbs"><a asp-action="Index">Screening and ranking</a> / Compare</div>
        <h1>Compare applicants</h1>
    </div>
</div>

@{
    var criteriaNames = Model.Rows
        .SelectMany(r => r.Criteria)
        .Select(c => c.Name)
        .Distinct()
        .ToList();
}
<div class="card-x">
    <div class="table-responsive-x">
        <table class="table table-x compare-table">
            <thead>
                <tr>
                    <th>Criterion</th>
                    @foreach (var r in Model.Rows)
                    {
                        <th>
                            <div class="d-flex flex-column align-items-center gap-1">
                                <span class="avatar avatar-sm">@r.Applicant.Initials</span>
                                @r.Applicant.DisplayName
                                <span class="text-muted fw-normal small">@r.Applicant.Sport?.Name</span>
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var name in criteriaNames)
                {
                    var values = Model.Rows.Select(r => r.Criteria.FirstOrDefault(c => c.Name == name)?.Value).ToList();
                    var present = values.Where(v => v.HasValue).Select(v => v!.Value).ToList();
                    double? best = present.Count > 0 ? present.Max() : null;
                    <tr>
                        <td class="fw-semibold">@name</td>
                        @foreach (var v in values)
                        {
                            <td class="@(v.HasValue && best.HasValue && v.Value == best.Value ? "compare-best" : "")">@(v.HasValue ? v.Value.ToString("0.0") : "—")</td>
                        }
                    </tr>
                }
                <tr>
                    <td class="fw-semibold">Overall score</td>
                    @{ var overalls = Model.Rows.Select(r => r.Overall).ToList(); var bestOverall = overalls.Max(); }
                    @foreach (var r in Model.Rows)
                    {
                        <td class="@(r.Overall == bestOverall ? "compare-best" : "")">@r.Overall.ToString("0.0")</td>
                    }
                </tr>
                <tr>
                    <td class="fw-semibold">Rank in sport</td>
                    @foreach (var r in Model.Rows) { <td>#@r.Rank</td> }
                </tr>
                <tr>
                    <td class="fw-semibold">Result</td>
                    @foreach (var r in Model.Rows)
                    {
                        <td>
                            @if (r.Qualified) { <span class="badge-soft badge-soft-success">Qualified</span> }
                            else { <span class="badge-soft badge-soft-muted">Below @r.Required</span> }
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light-x"><i class="bi bi-arrow-left me-1"></i>Back to ranking</a>
    </div>
</div>
