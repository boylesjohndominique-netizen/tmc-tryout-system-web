@model ApplicantFormViewModel
@{ ViewData["Title"] = "Register for a sport"; }
<div class="page-head"><div><h1>Register for a sport</h1><p>Fill in your details, upload your ID pictures and choose your sport.</p></div></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card-x" data-once>
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-gold"><i class="bi bi-check2 me-1"></i>Submit registration</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
