@model ApplicantFormViewModel
@{ ViewData["Title"] = "Edit registration"; }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">My registration</a> / Edit</div><h1>Edit my registration</h1></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card-x" data-once>
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button>
        <a asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
