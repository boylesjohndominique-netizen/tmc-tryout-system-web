@model ExploreSportsViewModel
@{
    ViewData["Title"] = "Explore sports";
}

<div class="page-head">
    <div>
        <h1>Explore sports</h1>
        <p>Every sport you can try out for at Trinidad Municipal College.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Registration" asp-action="Create" class="btn btn-gold"><i class="bi bi-plus-lg me-1"></i>Register for a sport</a>
    </div>
</div>

@if (Model.Sports.Count == 0)
{
    <div class="card-x">
        <div class="empty-state">
            <div class="icon-tile gold"><i class="bi bi-compass"></i></div>
            <h3>No open sports right now</h3>
            <p>The athletics office has not opened any sports for tryouts yet. Check back soon.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var card in Model.Sports)
        {
            var s = card.Sport;
            bool mine = Model.MyTryoutSportIds.Contains(s.Id);
            <div class="col-md-6 col-xl-4">
                <div class="card-x sport-card h-100">
                    <div class="d-flex align-items-start gap-3">
                        <div class="icon-tile gold"><i class="bi bi-@s.Icon"></i></div>
                        <div class="flex-grow-1">
                            <h3>@s.Name</h3>
                            @if (mine)
                            {
                                <span class="badge-soft badge-soft-success"><i class="bi bi-check-circle-fill"></i>You are trying out</span>
                            }
                            else if (card.TryoutCount > 0)
                            {
                                <span class="badge-soft badge-soft-info"><i class="bi bi-calendar-event"></i>@card.TryoutCount upcoming @(card.TryoutCount == 1 ? "tryout" : "tryouts")</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-muted">Open for registration</span>
                            }
                        </div>
                    </div>
                    <p>@(string.IsNullOrWhiteSpace(s.Description) ? "Try out and represent TMC in this sport." : s.Description)</p>
                    <div class="sport-meta">
                        <div><strong>@card.PlayerCount</strong><small>Team players</small></div>
                        <div><strong>@s.QualifyingScore</strong><small>Qualifying score</small></div>
                        <div><strong>@(s.Slots.HasValue ? s.Slots.Value.ToString() : "-")</strong><small>Roster slots</small></div>
                        <div><strong>@s.Staff.Count(x => x.User?.Role == Roles.Coach)</strong><small>Coach@(s.Staff.Count(x => x.User?.Role == Roles.Coach) == 1 ? "" : "es")</small></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-auto">
                        @if (s.Staff.Where(x => x.User?.Role == Roles.Coach).Select(x => x.User!).OrderBy(u => u.FullName).Take(2).ToList() is { Count: > 0 } coaches)
                        {
                            @foreach (var c in coaches)
                            {
                                <span class="staff-chip"><span class="avatar">@c.FullName[..1].ToUpperInvariant()</span>@c.FullName</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No coach assigned yet</span>
                        }
                    </div>
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-light-x btn-sm mt-3 align-self-start">View details</a>
                </div>
            </div>
        }
    </div>
}
