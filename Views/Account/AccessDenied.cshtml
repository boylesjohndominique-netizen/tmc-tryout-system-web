@{
    ViewData["Title"] = "Access denied";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="error-wrap">
    <div class="icon-tile gold mx-auto mb-3" style="width:64px;height:64px;font-size:1.8rem"><i class="bi bi-shield-lock"></i></div>
    <h1 class="h3 fw-bold">You do not have access to this page</h1>
    <p class="text-muted">Your role cannot open this area. If you think this is a mistake, contact the athletics office.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Back to dashboard</a>
</div>
