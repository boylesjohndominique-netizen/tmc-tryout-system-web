@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<h2>Welcome back</h2>
<p class="lead-sm">Sign in to manage tryouts, evaluations and results.</p>

<partial name="_Alerts" />

<form asp-action="Login" method="post" data-once>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-x"></div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label">Username</label>
        <div class="input-icon">
            <i class="bi bi-person"></i>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus placeholder="Enter your username" />
        </div>
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="input-icon">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" id="loginPassword" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
            <button type="button" class="pw-toggle" data-toggle-password="#loginPassword" aria-label="Show or hide password"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">Keep me signed in on this device</label>
    </div>

    <button type="submit" class="btn btn-gold w-100 py-2"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</button>
</form>

<p class="text-center mt-4 mb-0 text-muted">
    New student-athlete? <a asp-action="Register" class="fw-semibold">Create an account</a>
</p>

