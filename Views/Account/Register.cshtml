@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
    ViewData["HeroTitle"] = "Your tryout starts here.";
    ViewData["HeroSubtitle"] = "Create your account and get your student ID approved.";
}

<h2>Create your student account</h2>
<p class="lead-sm">Have your student ID ready for verification.</p>

<partial name="_Alerts" />

<form asp-action="Register" method="post" enctype="multipart/form-data" data-once data-id-form>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-x"></div>

    <div class="row g-3 mb-3">
        <div class="col-sm-4">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus placeholder="Juan" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="MiddleName" class="form-label"></label>
            <input asp-for="MiddleName" class="form-control" autocomplete="additional-name" placeholder="Optional" />
            <span asp-validation-for="MiddleName" class="text-danger"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" placeholder="Dela Cruz" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="StudentId" class="form-label"></label>
        <input asp-for="StudentId" class="form-control" placeholder="@UiHelpers.StudentIdExample" inputmode="numeric" autocomplete="off" />
        <div class="form-text">@UiHelpers.StudentIdHint</div>
        <span asp-validation-for="StudentId" class="text-danger"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="CourseOrGrade" class="form-label"></label>
            <select asp-for="CourseOrGrade" class="form-select">
                <option value="">Select your course</option>
                @foreach (var c in UiHelpers.Courses) { <option value="@c">@c</option> }
            </select>
            <span asp-validation-for="CourseOrGrade" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="YearLevel" class="form-label"></label>
            <select asp-for="YearLevel" class="form-select">
                <option value="">Select</option>
                @foreach (var y in UiHelpers.YearLevels) { <option value="@y">@y</option> }
            </select>
            <div class="form-text">Open to 1st to 4th year.</div>
            <span asp-validation-for="YearLevel" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="IdPictureFront" class="form-label"></label>
        <div class="id-capture" data-id-capture>
            <input asp-for="IdPictureFront" type="file" accept="image/*" class="id-capture-input" />
            <div class="id-capture-actions">
                <button type="button" class="btn btn-sm btn-light-x" data-capture="camera"><i class="bi bi-camera me-1"></i>Take photo</button>
                <button type="button" class="btn btn-sm btn-light-x" data-capture="gallery"><i class="bi bi-images me-1"></i>Choose from gallery</button>
            </div>
            <div class="id-capture-preview" data-capture-preview hidden>
                <img alt="Front of student ID preview" />
                <span class="id-capture-note" data-capture-note></span>
            </div>
        </div>
        <div class="form-text">Lay flat, fill the frame, use good lighting. No blur or filters.</div>
        <span asp-validation-for="IdPictureFront" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdPictureBack" class="form-label"></label>
        <div class="id-capture" data-id-capture>
            <input asp-for="IdPictureBack" type="file" accept="image/*" class="id-capture-input" />
            <div class="id-capture-actions">
                <button type="button" class="btn btn-sm btn-light-x" data-capture="camera"><i class="bi bi-camera me-1"></i>Take photo</button>
                <button type="button" class="btn btn-sm btn-light-x" data-capture="gallery"><i class="bi bi-images me-1"></i>Choose from gallery</button>
            </div>
            <div class="id-capture-preview" data-capture-preview hidden>
                <img alt="Back of student ID preview" />
                <span class="id-capture-note" data-capture-note></span>
            </div>
        </div>
        <div class="form-text">Photograph the back just as clearly.</div>
        <span asp-validation-for="IdPictureBack" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
        <div class="form-text">We'll send a 6-digit verification code here.</div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" id="registerPassword" class="form-control" autocomplete="new-password" />
            <button type="button" class="pw-toggle" data-toggle-password="#registerPassword" aria-label="Show or hide password"><i class="bi bi-eye"></i></button>
        </div>
        <div class="form-text">At least 8 characters with a letter and a number.</div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-lock-fill"></i>
            <input asp-for="ConfirmPassword" id="registerConfirmPassword" class="form-control" autocomplete="new-password" />
            <button type="button" class="pw-toggle" data-toggle-password="#registerConfirmPassword" aria-label="Show or hide password"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-gold w-100 py-2" data-id-submit><i class="bi bi-person-plus me-1"></i>Create account</button>
</form>

<p class="text-center mt-4 mb-0 text-muted">
    Already have an account? <a asp-action="Login" class="fw-semibold">Sign in</a>
</p>

<script src="~/js/id-capture.js" asp-append-version="true"></script>
