@model ProfileViewModel
@{ ViewData["Title"] = "My profile"; }

<div class="page-head">
    <div>
        <h1>My account</h1>
        <p>Update how your name and contact details appear in the system.</p>
    </div>
</div>

<partial name="_AccountTabs" model="@("profile")" />

<div class="row">
    <div class="col-xl-7 col-lg-8">
        <form asp-action="Profile" method="post" class="card-x" data-once>
            <div class="form-section">
                <div class="profile-head mb-4">
                    <span class="avatar avatar-gold avatar-lg">@(string.Concat(Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0]))))</span>
                    <div>
                        <h2>@Model.FullName</h2>
                        <span class="badge-soft badge-soft-info"><i class="bi bi-@UiHelpers.RoleIcon(Model.Role)"></i>@Model.Role</span>
                    </div>
                </div>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-x"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <input class="form-control" value="@Model.Username" disabled />
                        <div class="form-text">Usernames cannot be changed.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button>
            </div>
        </form>
    </div>
</div>
