@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var initials = string.Concat(Model.FullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpperInvariant(p[0])));
}

<div class="page-head">
    <div>
        <h1>My account</h1>
        <p>Manage your identity and how you appear across the system.</p>
    </div>
</div>

<partial name="_AccountTabs" model="@("profile")" />

<form asp-action="Profile" method="post" enctype="multipart/form-data" data-once>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-x"></div>

    <div class="row g-4">
        <div class="col-lg-5 col-xl-4">
            <div class="card-x profile-card">
                <div class="profile-hero"></div>
                <div class="profile-identity">
                    <span class="avatar avatar-gold profile-avatar">
                        @if (Model.HasProfilePicture)
                        {
                            <img src="@Model.ProfilePicturePath" alt="@Model.FullName profile picture" />
                        }
                        else
                        {
                            @initials
                        }
                    </span>
                    <h2>@Model.FullName</h2>
                    <span class="badge-soft badge-soft-info"><i class="bi bi-@UiHelpers.RoleIcon(Model.Role)"></i>@Model.Role</span>

                    @if (Model.IsStudent)
                    {
                        <div class="profile-badges">
                            @if (Model.EmailVerified)
                            {
                                <span class="badge-soft badge-soft-success"><i class="bi bi-envelope-check-fill"></i>Email verified</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-danger"><i class="bi bi-envelope-exclamation-fill"></i>Email not verified</span>
                            }
                            @if (Model.IdVerified)
                            {
                                <span class="badge-soft badge-soft-success"><i class="bi bi-patch-check-fill"></i>Student ID approved</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-warning"><i class="bi bi-hourglass-split"></i>ID awaiting approval</span>
                            }
                        </div>
                    }

                    <dl class="profile-facts">
                        @if (Model.IsStudent)
                        {
                            <div class="fact">
                                <i class="bi bi-person-vcard"></i>
                                <div>
                                    <span class="k">Student ID</span>
                                    <span class="v">@(Model.StudentId ?? "—")</span>
                                </div>
                            </div>
                            <div class="fact">
                                <i class="bi bi-envelope"></i>
                                <div>
                                    <span class="k">Email</span>
                                    <span class="v">@Model.Email</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="fact">
                                <i class="bi bi-at"></i>
                                <div>
                                    <span class="k">Username</span>
                                    <span class="v">@Model.Username</span>
                                </div>
                            </div>
                        }
                    </dl>

                    @if (Model.IsStudent)
                    {
                        @if (!Model.IdVerified && !string.IsNullOrWhiteSpace(Model.VerificationRemarks))
                        {
                            <div class="profile-note">
                                <i class="bi bi-info-circle"></i>
                                <span>@Model.VerificationRemarks</span>
                            </div>
                        }
                        <a asp-action="VerificationStatus" class="btn btn-sm btn-light-x w-100 mt-3">
                            <i class="bi bi-shield-check me-1"></i>Verification details
                        </a>
                    }
                </div>

                <div class="form-section profile-picture-section">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                    <input asp-for="ProfilePicture" type="file" accept="image/*" class="form-control" />
                    <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                    <div class="form-text">JPG, PNG, WEBP or GIF up to 5 MB.</div>
                    @if (Model.HasProfilePicture)
                    {
                        <div class="form-check mt-2">
                            <input asp-for="RemoveProfilePicture" class="form-check-input" />
                            <label asp-for="RemoveProfilePicture" class="form-check-label"></label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7 col-xl-8">
            <div class="card-x">
                <div class="card-x-head">
                    <h2><i class="bi bi-person-lines-fill"></i>Personal details</h2>
                </div>
                <div class="card-x-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        @if (Model.IsStudent)
                        {
                            <div class="col-md-6">
                                <label asp-for="CourseOrGrade" class="form-label"></label>
                                <select asp-for="CourseOrGrade" class="form-select">
                                    <option value="">Select your course</option>
                                    @foreach (var c in UiHelpers.Courses) { <option value="@c">@c</option> }
                                </select>
                                <span asp-validation-for="CourseOrGrade" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="YearLevel" class="form-label"></label>
                                <select asp-for="YearLevel" class="form-select">
                                    <option value="">Select</option>
                                    @foreach (var y in UiHelpers.YearLevels) { <option value="@y">@y</option> }
                                </select>
                                <div class="form-text">Open to 1st to 4th year.</div>
                                <span asp-validation-for="YearLevel" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        }
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button>
                </div>
            </div>
        </div>
    </div>
</form>
