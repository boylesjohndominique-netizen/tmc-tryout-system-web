@model CategoryFormViewModel
@{ ViewData["Title"] = "Add category"; }

<div class="page-head">
    <div>
        <div class="crumbs"><a asp-action="Index">Sport categories</a> / Add category</div>
        <h1>Add category</h1>
    </div>
</div>

<form asp-action="Create" method="post" class="card-x" data-once>
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Add category</button>
        <a asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
