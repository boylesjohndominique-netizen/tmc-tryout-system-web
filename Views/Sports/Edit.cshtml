@model SportFormViewModel
@{ ViewData["Title"] = "Edit sport"; }

<div class="page-head">
    <div>
        <div class="crumbs"><a asp-action="Index">Sports</a> / Edit sport</div>
        <h1>Edit @Model.Name</h1>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card-x" data-once>
    <input type="hidden" asp-for="Id" />
    <partial name="_SportForm" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button>
        <a asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
