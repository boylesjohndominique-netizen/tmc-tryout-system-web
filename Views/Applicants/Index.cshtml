@model StudentRecordListViewModel
@{
    ViewData["Title"] = "Applicant records";
    bool isAdmin = User.IsInRole(Roles.Admin);
}

<div class="page-head">
    <div>
        <h1>Applicant records</h1>
        <p>Every student account, one row per student. Verify a student here — until you do, they can browse but cannot submit a tryout.</p>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-4">
        <div class="card-x h-100"><div class="card-x-body">
            <small class="text-muted d-block">Student accounts</small>
            <strong class="h3 fw-bold">@Model.TotalBeforeFilter</strong>
        </div></div>
    </div>
    <div class="col-sm-4">
        <div class="card-x h-100"><div class="card-x-body">
            <small class="text-muted d-block">Awaiting your approval</small>
            <strong class="h3 fw-bold">@Model.AwaitingApproval</strong>
        </div></div>
    </div>
    <div class="col-sm-4">
        <div class="card-x h-100"><div class="card-x-body">
            <small class="text-muted d-block">Verified</small>
            <strong class="h3 fw-bold">@Model.VerifiedCount</strong>
        </div></div>
    </div>
</div>

<div class="card-x">
    <form method="get" class="filter-bar">
        <div class="field grow">
            <label for="search">Search</label>
            <div class="search-box"><i class="bi bi-search"></i><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Name, student ID or email" /></div>
        </div>
        <div class="field">
            <label for="course">Course</label>
            <select id="course" name="course" class="form-select">
                <option value="">All courses</option>
                @foreach (var c in Model.Courses) { <option value="@c" selected="@(Model.Course == c)">@c</option> }
            </select>
        </div>
        <div class="field">
            <label for="verification">Status</label>
            <select id="verification" name="verification" class="form-select">
                <option value="">Any status</option>
                <option value="pending" selected="@(Model.Verification == "pending")">Awaiting approval</option>
                <option value="verified" selected="@(Model.Verification == "verified")">Verified</option>
                <option value="email" selected="@(Model.Verification == "email")">Email not verified</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-light-x">Reset</a>
        </div>
    </form>

    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <div class="icon-tile"><i class="bi bi-people"></i></div>
            <h3>No student accounts match</h3>
            <p>@(Model.TotalBeforeFilter == 0 ? "Students appear here as soon as they create an account." : "Try a different search or clear the filters.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive-x">
            <table class="table table-x">
                <thead>
                    <tr>
                        <th>Full name</th>
                        <th>Student ID</th>
                        <th>Course / year</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    var s = row.Student;
                    <tr>
                        <td>
                            <a asp-action="StudentAccount" asp-route-id="@s.Id" class="person text-reset">
                                <span class="avatar avatar-sm">@s.Initials</span>
                                <span>
                                    <strong>@s.FullName</strong>
                                    <small>@(row.TryoutCount == 0 ? "No tryout yet" : $"{row.TryoutCount} tryout {(row.TryoutCount == 1 ? "entry" : "entries")}")</small>
                                </span>
                            </a>
                        </td>
                        <td>@(string.IsNullOrEmpty(s.StudentId) ? "-" : s.StudentId)</td>
                        <td>@(string.IsNullOrEmpty(s.CourseOrGrade) ? "-" : s.CourseOrGrade)<span class="cell-sub">@s.YearLevel</span></td>
                        <td>@(string.IsNullOrEmpty(s.Email) ? "-" : s.Email)</td>
                        <td>
                            @if (!s.EmailVerified)
                            {
                                <span class="badge-soft badge-soft-danger"><i class="bi bi-envelope-exclamation-fill"></i>Email not verified</span>
                            }
                            else if (!s.IdVerified)
                            {
                                <span class="badge-soft badge-soft-warning"><i class="bi bi-hourglass-split"></i>Awaiting approval</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-success"><i class="bi bi-patch-check-fill"></i>Verified</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="StudentAccount" asp-route-id="@s.Id" class="btn-action" title="Open student account"><i class="bi bi-eye"></i></a>
                                @if (isAdmin)
                                {
                                    <form asp-action="ToggleStudentActive" asp-route-id="@s.Id" method="post" data-confirm="@(s.IsActive ? "Deactivate this student account? They will not be able to sign in." : "Reactivate this student account?") + " (" + s.DisplayName + ")"">
                                        <button type="submit" class="btn-action" title="@(s.IsActive ? "Deactivate account" : "Reactivate account")"><i class="bi @(s.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="result-note">Showing @Model.Rows.Count of @Model.TotalBeforeFilter @(Model.TotalBeforeFilter == 1 ? "student" : "students").</div>
    }
</div>
