@model ApplicantFormViewModel
@{ ViewData["Title"] = "Register applicant"; }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Applicant records</a> / Register applicant</div><h1>Register applicant</h1><p>Use this to register a student-athlete on their behalf.</p></div></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card-x" data-once>
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Register applicant</button>
        <a asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
