@model ScheduleFormViewModel
@{ ViewData["Title"] = "New schedule"; }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Schedules</a> / New schedule</div><h1>New tryout schedule</h1></div></div>
<form asp-action="Create" method="post" class="card-x" data-once>
    <partial name="_ScheduleForm" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Create schedule</button>
        <a asp-action="Index" class="btn btn-light-x">Cancel</a>
    </div>
</form>
